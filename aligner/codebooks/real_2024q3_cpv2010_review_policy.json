    {"concept":"H08","semantic_decision":"approve","temporal_role":"research-only","common_representation":"1=inside dwelling,2=inside lot,3=outside lot","eph":{"field":"IV6","map":{},"special_to_null":[],"universe":"household dwelling observations"},"census":{"field":"H08","map":{},"special_to_null":[],"universe":"household records"},"information_loss":{"eph":null,"census":null},"reviewer_reason":"Official categories align; donor-vintage water-access state is research-only.","validation":{"allowed":[1,2,3]}},
    {"concept":"H09","semantic_decision":"approve","temporal_role":"research-only","common_representation":"1=public network,2=motor bore,3=manual bore,4=other source","eph":{"field":"IV7","map":{},"special_to_null":[],"universe":"household dwelling observations"},"census":{"field":"H09","map":{"1":1,"2":2,"3":3,"4":4,"5":4,"6":4},"special_to_null":[],"universe":"household records"},"information_loss":{"eph":null,"census":"Well, tanker and surface/rain sources collapse to common other source."},"reviewer_reason":"A truthful coarsening exists; donor-vintage water source is research-only.","validation":{"allowed":[1,2,3,4]}},
    {"concept":"H10","semantic_decision":"approve","temporal_role":"research-only","common_representation":"1=has bathroom/latrine,2=no","eph":{"field":"IV8","map":{},"special_to_null":[],"universe":"household dwelling observations"},"census":{"field":"H10","map":{},"special_to_null":[],"universe":"household records"},"information_loss":{"eph":null,"census":null},"reviewer_reason":"Official binary semantics align; donor-vintage state is research-only.","validation":{"allowed":[1,2]}},
    {"concept":"H11","semantic_decision":"needs-judgment","temporal_role":"unresolved","common_representation":"toilet flush capability","eph":{"field":"IV10","map":{},"special_to_null":[],"universe":"households with bathroom/latrine"},"census":{"field":"H11","map":{},"special_to_null":[],"universe":"households with bathroom/latrine"},"information_loss":{"eph":null,"census":null},"reviewer_reason":"EPH distinguishes automatic water, bucket water and no-water latrine while Census asks button/chain/cistern availability; a clearly justified recode is not established.","validation":{}},
