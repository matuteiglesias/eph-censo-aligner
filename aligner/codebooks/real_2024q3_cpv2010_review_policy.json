  "concepts": [
    {"concept":"IX_TOT","semantic_decision":"approve","temporal_role":"target-period-state","common_representation":"positive integer household member count","eph":{"field":"IX_TOT","map":{},"special_to_null":[],"universe":"all applicable source rows"},"census":{"field":"membership_count","map":{},"special_to_null":[],"universe":"all applicable source rows"},"information_loss":{"eph":null,"census":null},"reviewer_reason":"Same household-size concept is constructible on both sides, but 2010 household composition is not established as 2024 state.","validation":{"kind":"integer","min":1,"max":40}},
    {"concept":"P02","semantic_decision":"approve","temporal_role":"stable/shared","common_representation":"1=male, 2=female","eph":{"field":"CH04","map":{},"special_to_null":[],"universe":"all person records"},"census":{"field":"P02","map":{},"special_to_null":[],"universe":"all person records"},"information_loss":{"eph":null,"census":null},"reviewer_reason":"Official codebooks agree on sex coding and universe for person records.","validation":{"allowed":[1,2]}},
    {"concept":"P03","semantic_decision":"approve","temporal_role":"target-period-state","common_representation":"age in completed years","eph":{"field":"CH06","map":{},"special_to_null":[],"universe":"all person records"},"census":{"field":"P03","map":{},"special_to_null":[],"universe":"all person records"},"information_loss":{"eph":null,"census":null},"reviewer_reason":"Official definitions agree, but donor age is observed in 2010 rather than 2024.","validation":{"kind":"integer","min":0,"max":120}},
    {"concept":"P05","semantic_decision":"approve","temporal_role":"stable/shared","common_representation":"1=Argentina-born, 2=foreign-born","eph":{"field":"CH15","map":{"1":1,"2":1,"3":1,"4":2,"5":2},"special_to_null":[9],"universe":"all person records"},"census":{"field":"P05","map":{"1":1,"2":2},"special_to_null":[],"universe":"all person records"},"information_loss":{"eph":"Domestic birthplace detail and border/other-country detail are collapsed.","census":null},"reviewer_reason":"Birth-country status is time-stable; EPH finer birthplace categories collapse truthfully to the Census binary concept.","validation":{"allowed":[1,2]}},
    {"concept":"P07","semantic_decision":"approve","temporal_role":"target-period-state","common_representation":"1=literate, 2=not literate","eph":{"field":"CH09","map":{"1":1,"2":2},"special_to_null":[3],"universe":"age 2+ after removing EPH under-2 special state"},"census":{"field":"P07","map":{"1":1,"2":2},"special_to_null":[],"universe":"age 3+"},"information_loss":{"eph":"EPH under-2 special state excluded from common universe.","census":null},"reviewer_reason":"Literacy meaning aligns after excluding the non-common young-child state; 2010 literacy is temporally stale for 2024.","validation":{"allowed":[1,2]}},
    {"concept":"P08","semantic_decision":"approve","temporal_role":"target-period-state","common_representation":"1=attends, 2=attended, 3=never attended","eph":{"field":"CH10","map":{},"special_to_null":[],"universe":"education-question universe"},"census":{"field":"P08","map":{},"special_to_null":[],"universe":"age 3+"},"information_loss":{"eph":null,"census":null},"reviewer_reason":"Official categories align; attendance is target-period state.","validation":{"allowed":[1,2,3]}},
    {"concept":"P09","semantic_decision":"approve","temporal_role":"target-period-state","common_representation":"education level code 1..9 on shared ordered taxonomy","eph":{"field":"CH12","map":{},"special_to_null":[],"universe":"persons who attend or attended education"},"census":{"field":"P09","map":{},"special_to_null":[],"universe":"persons who attend or attended education"},"information_loss":{"eph":null,"census":null},"reviewer_reason":"Official category systems align at the review resolution; education can change after 2010.","validation":{"allowed":[1,2,3,4,5,6,7,8,9]}},
    {"concept":"P10","semantic_decision":"approve","temporal_role":"target-period-state","common_representation":"1=completed, 2=not completed; unknown=null","eph":{"field":"CH13","map":{"1":1,"2":2},"special_to_null":[9],"universe":"persons with a declared education level"},"census":{"field":"P10","map":{"1":1,"2":2},"special_to_null":[3],"universe":"persons with a declared education level"},"information_loss":{"eph":"Unknown status becomes null.","census":"Unknown status becomes null."},"reviewer_reason":"Completion meaning aligns once survey-specific unknown codes are normalized to null; state can change.","validation":{"allowed":[1,2]}},
    {"concept":"CONDACT","semantic_decision":"approve","temporal_role":"target-period-state","common_representation":"1=employed, 2=unemployed, 3=inactive; non-common states=null","eph":{"field":"ESTADO","map":{"1":1,"2":2,"3":3},"special_to_null":[0,4],"universe":"age 14+ for common plane; EPH nonresponse and under-10 states excluded"},"census":{"field":"CONDACT","map":{"1":1,"2":2,"3":3},"special_to_null":[],"universe":"age 14+"},"information_loss":{"eph":"EPH individual nonresponse and under-10 states excluded; common plane restricted to age 14+.","census":null},"reviewer_reason":"Activity categories are semantically comparable on age 14+, but 2010 labor state is not admissible as observed 2024 state.","validation":{"allowed":[1,2,3]}},
    {"concept":"V01","semantic_decision":"approve","temporal_role":"research-only","common_representation":"1=house,2=apartment,3=tenement,4=hotel/pension,5=nonresidential,6=other/precarious/mobile","eph":{"field":"IV1","map":{},"special_to_null":[],"universe":"private household dwelling observation"},"census":{"field":"V01","map":{"1":1,"2":6,"3":6,"4":2,"5":3,"6":4,"7":5,"8":6,"9":6},"special_to_null":[],"universe":"Census dwelling records"},"information_loss":{"eph":null,"census":"Rancho, casilla, mobile dwelling and street-person categories collapse to other/precarious/mobile."},"reviewer_reason":"A defensible common dwelling-type taxonomy exists, but donor-vintage dwelling type is research-only for 2024 transport.","validation":{"allowed":[1,2,3,4,5,6]}},
    {"concept":"H05","semantic_decision":"approve","temporal_role":"research-only","common_representation":"floor material codes 1..4","eph":{"field":"IV3","map":{},"special_to_null":[],"universe":"household dwelling observations"},"census":{"field":"H05","map":{},"special_to_null":[],"universe":"household records"},"information_loss":{"eph":null,"census":null},"reviewer_reason":"Official categories align; donor-vintage housing state is research-only.","validation":{"allowed":[1,2,3,4]}},
