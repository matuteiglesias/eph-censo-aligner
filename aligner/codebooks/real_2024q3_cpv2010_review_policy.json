    {"concept":"H13","semantic_decision":"approve","temporal_role":"research-only","common_representation":"1=exclusive bathroom use,2=shared bathroom use; no-bathroom=null","eph":{"field":"II9","map":{"1":1,"2":2,"3":2},"special_to_null":[4],"universe":"household; common representation conditional on bathroom existence"},"census":{"field":"H13","map":{"1":1,"2":2},"special_to_null":[],"universe":"households with bathroom/latrine"},"information_loss":{"eph":"Sharing within vs across dwellings collapses to shared; no-bathroom becomes null and is represented separately by H10.","census":null},"reviewer_reason":"Exclusive/shared use aligns after coarsening and conditioning on bathroom existence; donor-vintage state is research-only.","validation":{"allowed":[1,2]}},
    {"concept":"H14","semantic_decision":"approve","temporal_role":"research-only","common_representation":"1=network gas,2=bulk/tube/bottled gas,3=solid/kerosene,4=other/electric","eph":{"field":"II8","map":{"1":1,"2":2,"3":3,"4":4},"special_to_null":[],"universe":"household records"},"census":{"field":"H14","map":{"1":1,"2":2,"3":2,"4":2,"5":4,"6":3,"7":4},"special_to_null":[],"universe":"household records"},"information_loss":{"eph":null,"census":"Bulk, tube and bottled gas collapse; electricity joins other; wood/coal joins EPH solid/kerosene group."},"reviewer_reason":"A common energy-source taxonomy is explicit and auditable; donor-vintage cooking fuel is research-only.","validation":{"allowed":[1,2,3,4]}},
    {"concept":"H15","semantic_decision":"approve","temporal_role":"research-only","common_representation":"integer sleeping-room count","eph":{"field":"II2","map":{},"special_to_null":[],"universe":"household records"},"census":{"field":"H15","map":{},"special_to_null":[],"universe":"household records"},"information_loss":{"eph":null,"census":null},"reviewer_reason":"Official room-for-sleeping count concept aligns; donor-vintage housing state is research-only.","validation":{"kind":"integer","min":0,"max":30}},
    {"concept":"H16","semantic_decision":"needs-judgment","temporal_role":"unresolved","common_representation":"room count","eph":{"field":"II1","map":{},"special_to_null":[],"universe":"household records"},"census":{"field":"H16","map":{},"special_to_null":[],"universe":"household records"},"information_loss":{"eph":null,"census":null},"reviewer_reason":"EPH counts rooms for exclusive household use, while Census explicitly excludes bathrooms and kitchens; equivalence is not established.","validation":{}},
    {"concept":"PROP","semantic_decision":"approve","temporal_role":"research-only","common_representation":"1=owner dwelling+land,2=owner dwelling only,3=tenant,4=employment-tied,5=other occupancy","eph":{"field":"II7","map":{"1":1,"2":2,"3":3,"4":5,"5":4,"6":5,"7":5,"8":5,"9":5},"special_to_null":[],"universe":"household records"},"census":{"field":"PROP","map":{"1":1,"2":2,"3":3,"4":5,"5":4,"6":5},"special_to_null":[],"universe":"household records"},"information_loss":{"eph":"Tax-paying, permission, de-facto, succession and other occupancy collapse to other.","census":"Borrowed and other occupancy collapse to other."},"reviewer_reason":"A broad common tenure taxonomy is explicit; donor-vintage tenure is research-only.","validation":{"allowed":[1,2,3,4,5]}}
